---
import './OurTestimonials.scss'
import Section from '@/components/Section/Section.astro'
import Slider from '@/components/Slider/Slider.astro'

interface Testimonial {
  text: string
  author: string
}

interface TestimonialTab {
  tabName: string
  slides: Testimonial[]
}

const testimonialTabs: TestimonialTab[] = [
  {
    tabName: 'For Individuals',
    slides: [
      {
        text: 'I recently started my own business, and YourBank has been instrumental in helping me set up my business accounts and secure the financing I needed. Their expert guidance and tailored solutions have been invaluable.',
        author: 'John D',
      },
      {
        text: 'YourBank made getting a mortgage stress-free. Their team guided us through every step and got us a great rate.',
        author: 'Sarah M',
      },
      {
        text: 'The mobile app is fantastic. I can manage all my accounts in seconds.',
        author: 'Mike R',
      },
      {
        text: 'Customer support is top-notch. They resolved my issue in minutes.',
        author: 'Emily K',
      },
      {
        text: 'YourBank made getting a mortgage stress-free. Their team guided us through every step and got us a great rate.',
        author: 'Sarah M',
      },
      {
        text: 'The mobile app is fantastic. I can manage all my accounts in seconds.',
        author: 'Mike R',
      },
    ]
  },
  {
    tabName: 'For Businesses',
    slides: [
      {
        text: 'I recently started my own business, and YourBank has been instrumental in helping me set up my business accounts and secure the financing I needed. Their expert guidance and tailored solutions have been invaluable. 2',
        author: 'John D',
      },
      {
        text: 'YourBank made getting a mortgage stress-free. Their team guided us through every step and got us a great rate. 2',
        author: 'Sarah M',
      },
      {
        text: 'The mobile app is fantastic. I can manage all my accounts in seconds. 2',
        author: 'Mike R',
      },
      {
        text: 'YourBank made getting a mortgage stress-free. Their team guided us through every step and got us a great rate. 2',
        author: 'Sarah M',
      },
      {
        text: 'Customer support is top-notch. They resolved my issue in minutes. 2',
        author: 'Emily K',
      },
      {
        text: 'The mobile app is fantastic. I can manage all my accounts in seconds. 2',
        author: 'Mike R',
      },
    ]
  },
]
---

<Section
  className="our-testimonials"
  id="our-testimonials"
  tabs={ testimonialTabs.map((tab) => tab.tabName) }
>
  <Fragment slot="header">
    <h2
      id="our-products-title"
      class="h1"
    >
      Our <span>Testimonials</span>
    </h2>
    <p>
      Discover how YourBank has transformed lives with innovative digital
      solutions and personalized customer service. See why our clients trust us
      for a secure and prosperous financial journey
    </p>
  </Fragment>

  <div class="our-testimonials__inner">
    {
      testimonialTabs.map((panel, index) => (
        <div
          role="tabpanel"
          id={ `our-testimonials-panel-${ index }` }
          aria-labelledby={ `our-testimonials-tab-${ index }` }
          hidden={ index !== 0 }
        >
          <Slider>
            { panel.slides.map(({ text, author }, index) => (
              <div class="our-testimonials__slide swiper-slide slider__slide">
                <div class="our-testimonials__quote-icon">
                  <svg
                    width="60"
                    height="60"
                    viewBox="0 0 60 60"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M21.269 47.8235C21.269 49.2042 20.1498 50.3235 18.769 50.3235H7.50049C6.11978 50.3235 5.00049 49.2042 5.00049 47.8235V38.7161C5.00049 35.4601 5.59543 32.0841 6.77686 28.5911L6.77783 28.5881C7.99342 25.0631 9.63817 21.74 11.7114 18.6194V18.6174C13.5098 15.9252 15.4946 13.588 17.6655 11.6086C18.4988 10.8492 19.728 10.8006 20.6431 11.4104L26.6694 15.426C27.8098 16.1859 28.1142 17.7084 27.4194 18.8655C25.8007 21.5607 24.409 24.3541 23.2476 27.2463L23.2485 27.2473C21.8966 30.6653 21.2342 34.4484 21.269 38.6028V47.8235ZM48.1489 47.8235C48.1489 49.2042 47.0296 50.3235 45.6489 50.3235H34.3804C32.9997 50.3235 31.8804 49.2042 31.8804 47.8235V38.7161C31.8804 35.4601 32.4743 32.0841 33.6558 28.5911L33.6567 28.5881C34.8723 25.0631 36.5171 21.74 38.5903 18.6194L38.5913 18.6174C40.3896 15.9253 42.3736 13.588 44.5444 11.6086C45.3777 10.8489 46.6078 10.8006 47.5229 11.4104L53.5493 15.426C54.6896 16.1859 54.994 17.7084 54.2993 18.8655C52.6806 21.5607 51.2889 24.3541 50.1274 27.2463L50.1284 27.2473C48.7764 30.6653 48.1141 34.4484 48.1489 38.6028V47.8235Z"
                      fill="url(#paint0_linear_11_89096)"
                      stroke="#CAFF33"
                    />
                    <defs>
                      <linearGradient
                        id="paint0_linear_11_89096"
                        x1="30.2064"
                        y1="11.0002"
                        x2="30.2064"
                        y2="49.8238"
                        gradientUnits="userSpaceOnUse"
                      >
                        <stop stop-color="#CAFF33" />
                        <stop
                          offset="1"
                          stop-color="#191919"
                        />
                      </linearGradient>
                    </defs>
                  </svg>

                </div>
                <blockquote class="our-testimonials__quote">
                  <p class="our-testimonials__quote-text">{ text }</p>
                  <footer class="our-testimonials__author">
                    <span>{ author }</span>
                  </footer>
                </blockquote>
              </div>
            )) }
          </Slider>
        </div>
      ))
    }
  </div>
</Section>
