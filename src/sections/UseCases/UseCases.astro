---
import './UseCases.scss'
import Section from '@/components/Section/Section.astro'
import Button from '@/components/Button/Button.astro'
import Icon from '@/components/Icon/Icon.astro'
import Counters from '@/components/Counters/Counters.astro'

const personalGoals = [
  {
    iconName: 'finances',
    title: 'Managing Personal Finances'
  },
  {
    iconName: 'savings',
    title: 'Saving for the Future'
  },
  {
    iconName: 'homeownership',
    title: 'Homeownership'
  },
  {
    iconName: 'education',
    title: 'Education Funding'
  },
]

const businessGoals = [
  {
    iconName: 'startup',
    title: 'Startups and Entrepreneurs'
  },
  {
    iconName: 'loans',
    title: 'Cash Flow Management'
  },
  {
    iconName: 'business',
    title: 'Business Expansion'
  },
  {
    iconName: 'payment',
    title: 'Payment Solutions'
  },
]

const forIndividualsCounters = [
  { value: '78%', desc: "Secure Retirement Planning" },
  { value: '63%', desc: "Manageable Debt Consolidation" },
  { value: '91%', desc: "Reducing financial burdens" },
]

const forBusinessCounters = [
  { value: '65%', desc: "Cash Flow Management" },
  { value: '70%', desc: "Drive Business Expansion" },
  { value: '45%', desc: "Streamline payroll processing" },
]

const useCasesData = [
  {
    title: 'For Individuals',
    desc: 'For individuals, our mortgage services pave the way to homeownership, and our flexible personal loans provide vital support during various life milestones. We also prioritize retirement planning, ensuring a financially secure future for our customers',
    counters: forIndividualsCounters,
    h4: 'Financial Goals',
    goals: personalGoals
  },
  {
    title: 'For Business',
    desc: 'For businesses, we empower growth with working capital solutions that optimize cash flow, and our tailored financing options fuel business expansion. Whatever your financial aspirations, YourBank is committed to providing the right tools and support to achieve them',
    counters: forBusinessCounters,
    h4: 'Our Financial Solutions',
    goals: businessGoals
  },
]
---

<Section
  className="use-cases"
  id="use-cases"
>
  <Fragment slot="header">
    <h2
      id="use-cases-title"
      class="h1"
    >
      <span>Use Cases</span>
    </h2>
    <p>
      At YourBank, we cater to the diverse needs of individuals and businesses
      alike, offering a wide range of financial solutions
    </p>
  </Fragment>

  <div class="use-cases__inner">

    { useCasesData.map(({ title, desc, counters, h4, goals }) => (
      <div class="use-cases__item">
        <div class="use-cases__info">
          <div class="use-cases__intro">
            <h3 class="use-cases__intro-title h2">{ title }</h3>
            <p class="use-cases__intro-desc">{ desc }</p>
          </div>

          <Counters
            className="use-cases__counters"
            countersArray={ counters }
          />

          <Button
            className="use-cases__button"
            variant="dark"
          >
            Learn More
          </Button>
        </div>
        <div class="use-cases__cards">
          <h4 class="visually-hidden">{ h4 }</h4>
          <ul class="use-cases__cards-list">
            { goals.map(({ iconName, title: goalsTitle }) => (
              <li class="use-cases__cards-item">
                <Icon
                  className="use-cases__cards-icon"
                  variant="custom"
                  iconName={ iconName }
                  iconSize="small"
                />
                <p class="use-cases__cards-title">{ goalsTitle }</p>
              </li>
            )) }
          </ul>
        </div>
      </div>
    )) }
  </div>
</Section>
