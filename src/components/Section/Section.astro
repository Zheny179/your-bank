---
import './Section.scss'
import Tabs from '@/components/Tabs/Tabs.astro'

interface Props {
  className?: string
  tabs?: string[]
  isMarginL?: boolean
  id?: string
}

const {
  className,
  tabs,
  isMarginL = false,
  id,
  ...restProps
} = Astro.props

const sectionId = id ||
  `section-${ Astro.slots.has('header') ? 'labeled' : 'unnamed' }`
const headingId = `${ sectionId }-title`

const hasHeader = Astro.slots.has('header')
const isTabs = tabs && tabs.length > 0
const showHeader = hasHeader || isTabs
---

<section
  class:list={ [
    className, "section container", {
      'section--margin-l': isMarginL,
      'section--is-tabs': isTabs,
    }
  ] }
  aria-labelledby={ hasHeader ? headingId : undefined }
  {...restProps}
>
  { showHeader && (
    <header class="section__header">
      { hasHeader && (
        <div class="section__info">
          <slot name="header" />
        </div>) }
      { isTabs && (
        <Tabs
          tabs={ tabs }
          baseId={ sectionId }
        />
      ) }
    </header>) }
  <div class="section__body">
    <slot />
  </div>
</section>
