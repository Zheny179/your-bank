---
import './Navigation.scss'
import { navigationItems } from '@/data/navigation.ts'

const currentURL = Astro.url.pathname
const BASE_URL = import.meta.env.BASE_URL
const { className, extraAttrs = {}, context = 'header' } = Astro.props
const normalizeUrl = (url: string) => url.replace(/\/$/, '').toLowerCase()
---

<nav
  class:list={ [className, 'navigation'] }
  aria-label="Основное меню"
  {...extraAttrs}
>
  <ul class="navigation__list">
    { navigationItems.map(({ href, label }) => {
      const targetURL = `${ BASE_URL }${ href }`
      const isActive = normalizeUrl(currentURL) === normalizeUrl(targetURL)

      return (
        <li class="navigation__item">
          <a
            class:list={ [
              'navigation__link', {
                'navigation__link--active': isActive
              }
            ] }
            href={ targetURL }
            aria-current={ isActive ? 'page' : undefined }
            style={ isActive
              ? `view-transition-name: active-menu-indicator-${ context };`
              : undefined
            }
          >
            { label }
          </a>
        </li>
      )
    }) }
  </ul>
</nav>
