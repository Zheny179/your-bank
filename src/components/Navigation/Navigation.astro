---
import './Navigation.scss'

const currentURL = Astro.url.pathname
const BASE_URL = import.meta.env.BASE_URL

const navigationItems = [
  { href: '', label: 'Home' },
  { href: 'careers/', label: 'Careers' },
  { href: 'about/', label: 'About' },
  { href: 'security/', label: 'Security' },
]

const { className, extraAttrs } = Astro.props
---

<nav
  class:list={ [className, 'navigation'] }
  aria-label="Основное меню"
  {...extraAttrs}
>
  <ul class="navigation__list">
    { navigationItems.map(({ href, label }) => {
      const targetURL = `${ BASE_URL }${ href }`
      const isActive = currentURL === targetURL

      return (
        <li class="navigation__item">
          <a
            class:list={ [
              'navigation__link', {
                'navigation__link--active': currentURL === targetURL
              }
            ] }
            href={ targetURL }
            aria-label={ label }
            aria-current={ isActive ? 'page' : undefined }
            style={ isActive
              ? "view-transition-name: active-menu-indicator;"
              : undefined }
          >
            { label }
          </a>
        </li>
      )
    }) }
  </ul>
</nav>
