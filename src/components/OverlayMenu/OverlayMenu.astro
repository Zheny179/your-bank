---
import './OverlayMenu.scss'
import BurgerMenu from '../BurgerMenu/BurgerMenu.astro'
import Navigation from '../Navigation/Navigation.astro'

interface Props {
  className?: string;
  extraAttrs?: Record<string, string>;
}

const {
  className,
  extraAttrs
} = Astro.props
---

<div
  class:list={ ["overlay-menu", className] }
  data-overlay-menu=""
>
  <div class="overlay-menu__panel">
    <Navigation extraAttrs={ extraAttrs } />
  </div>
  <BurgerMenu
    rest={ {
      "aria-label": "Открыть меню навигации",
      "aria-expanded": "false",
      "aria-controls": "main-navigation",
      "aria-haspopup": "true"
    } }
  />
</div>


<script>
  function initOverlayMenu() {
    document.body.addEventListener('click', function (e) {
      const burgerButtonElement = (e.target as HTMLElement).closest<HTMLElement>(
        '[data-burger]'
      )
      if (burgerButtonElement) {
        handleMenuToggle(burgerButtonElement)
        return
      }

      const overlayPanel = (e.target as HTMLElement).closest<HTMLElement>(
        '.overlay-menu__panel'
      )
      if (overlayPanel && e.target === overlayPanel) {
        const menuContainer = overlayPanel.closest<HTMLElement>(
          '[data-overlay-menu]'
        )
        const associatedBurger = menuContainer?.querySelector<HTMLElement>(
          '[data-burger]'
        )
        if (associatedBurger) {
          handleMenuToggle(associatedBurger)
        }
      }
    })

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' || e.key === 'Esc') {
        const activeMenu = document.querySelector<HTMLElement>(
          '.overlay-menu.is-open'
        )
        if (activeMenu) {
          const associatedBurger = activeMenu.querySelector<HTMLElement>(
            '[data-burger]'
          )
          if (associatedBurger) {
            handleMenuToggle(associatedBurger)
          }
        }
      }
    })
  }

  function handleMenuToggle(burgerButtonElement: HTMLElement) {
    const overlayMenuElement = burgerButtonElement.closest<HTMLElement>(
      '[data-overlay-menu]'
    )
    if (!overlayMenuElement) return

    const navigationElement = overlayMenuElement.querySelector<HTMLElement>(
      '[data-navigation]'
    )

    const isExpanded = burgerButtonElement.getAttribute(
      'aria-expanded'
    ) === 'true'
    const isOpen = !isExpanded

    burgerButtonElement.setAttribute('aria-expanded', String(isOpen))
    burgerButtonElement.setAttribute(
      'aria-label',
      isOpen ? 'Закрыть меню навигации' : 'Открыть меню навигации'
    )

    if (isOpen) {
      burgerButtonElement.dataset.burger = 'active'
    } else {
      burgerButtonElement.dataset.burger = ''
    }

    navigationElement?.classList.toggle('navigation--active', isOpen)
    overlayMenuElement?.classList.toggle('is-open', isOpen)
    document.documentElement.classList.toggle('is-lock', isOpen)

    if (isOpen) {
      const firstLink = navigationElement?.querySelector<HTMLElement>(
        'a'
      )
      setTimeout(() => firstLink?.focus(), 100)
    } else {
      burgerButtonElement.focus()
    }
  }

  document.addEventListener('astro:page-load', initOverlayMenu)
</script>
