---
import './OverlayMenu.scss'
import BurgerMenu from '../BurgerMenu/BurgerMenu.astro'
import Navigation from '../Navigation/Navigation.astro'

interface Props {
  className?: string
  extraAttrs?: Record<string, string>
}

const {
  className,
  extraAttrs = {}
} = Astro.props
---

<div
  class:list={ ["overlay-menu", className] }
  data-overlay-menu=""
>
  <div class="overlay-menu__panel">
    <Navigation extraAttrs={ extraAttrs } />
  </div>
  <BurgerMenu
    rest={ {
      "aria-label": "Открыть меню навигации",
      "aria-expanded": "false",
      "aria-controls": "main-navigation",
      "aria-haspopup": "true"
    } }
  />
</div>


<script>
  function initOverlayMenu() {
    const overlayMenuElement = document.querySelector<HTMLElement>(
      '[data-overlay-menu]')

    if (!overlayMenuElement || overlayMenuElement.dataset.initialized) {
      return
    }

    overlayMenuElement.dataset.initialized = 'true'

    overlayMenuElement.addEventListener('click', function (e) {
      const target = e.target as HTMLElement
      const burgerButtonElement = target.closest<HTMLElement>('[data-burger]')

      if (burgerButtonElement) {
        handleMenuToggle(burgerButtonElement)
        return
      }

      const overlayPanel = target.closest<HTMLElement>('.overlay-menu__panel')

      if (overlayPanel && target === overlayPanel) {
        const associatedBurger = overlayMenuElement.querySelector<HTMLElement>(
          '[data-burger]'
        )

        if (associatedBurger) {
          handleMenuToggle(associatedBurger)
        }
      }
    })

    document.addEventListener('keydown', function (e) {
      if ((e.key === 'Escape' || e.key === 'Esc') &&
        overlayMenuElement.classList.contains('is-open')) {

        const associatedBurger = overlayMenuElement.querySelector<HTMLElement>(
          '[data-burger]'
        )

        if (associatedBurger) {
          handleMenuToggle(associatedBurger)
        }
      }
    })

    overlayMenuElement.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab') {
        return
      }

      if (!overlayMenuElement.classList.contains('is-open')) {
        return
      }

      const focusableElements = overlayMenuElement.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
      )

      if (focusableElements.length === 0) {
        return
      }

      const firstElement = focusableElements[0]
      const lastElement = focusableElements[focusableElements.length - 1]

      if (e.shiftKey) {
        if (document.activeElement === firstElement) {
          lastElement.focus()
          e.preventDefault()
        }
      } else {
        if (document.activeElement === lastElement) {
          firstElement.focus()
          e.preventDefault()
        }
      }
    })
  }

  function handleMenuToggle(burgerButtonElement: HTMLElement) {
    const overlayMenuElement = burgerButtonElement.closest<HTMLElement>(
      '[data-overlay-menu]'
    )
    if (!overlayMenuElement) {
      return
    }

    const navigationElement = overlayMenuElement.querySelector<HTMLElement>(
      '[data-navigation]'
    )
    const isExpanded = burgerButtonElement.getAttribute(
      'aria-expanded'
    ) === 'true'
    const isOpen = !isExpanded

    burgerButtonElement.setAttribute('aria-expanded', String(isOpen))
    burgerButtonElement.setAttribute(
      'aria-label',
      isOpen ? 'Закрыть меню навигации' : 'Открыть меню навигации'
    )

    burgerButtonElement.classList.toggle('is-active', isOpen)
    navigationElement?.classList.toggle('navigation--active', isOpen)
    overlayMenuElement?.classList.toggle('is-open', isOpen)
    document.documentElement.classList.toggle('is-lock', isOpen)

    if (isOpen) {
      const firstLink = navigationElement?.querySelector<HTMLElement>('a')
      requestAnimationFrame(() => firstLink?.focus())
    } else {
      burgerButtonElement.focus()
    }
  }

  document.addEventListener('astro:page-load', initOverlayMenu)
</script>
