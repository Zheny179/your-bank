---
import './Button.scss'

interface Props {
  className?: string;
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  variant?: '' | 'transparent' | 'dark'
}

const {
  className,
  href,
  type = 'button',
  variant,
  ...rest
} = Astro.props

const isButton = !href
const Component = isButton ? 'button' : 'a'
const componentProps = isButton
  ? { type }
  : { href }
---

<Component
  class:list={ [
    'button', className, {
      'button--transparent': variant === 'transparent',
      'button--dark': variant === 'dark',
    }
  ] }
  {...componentProps}
  {...rest}
>
  <slot />
</Component>
