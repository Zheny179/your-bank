---
import './Icon.scss'
import { Icon as AstroIcon } from 'astro-icon/components'

interface Props {
  className?: string;
  iconName: string;
  iconSize?: 'small' | 'big';
  variant?: '' | 'custom'
}

const {
  className,
  iconName,
  iconSize,
  variant = ''
} = Astro.props
---

<div
  class:list={ [
    "icon", className, {
      'icon--small': iconSize === 'small',
      'icon--big': iconSize === 'big',
      'icon--custom': variant === 'custom',
    }
  ] }
  aria-hidden="true"
>
  <AstroIcon name={ iconName } />
</div>
