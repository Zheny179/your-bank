---
import './Header.scss'
import Logo from '@/components/Logo/Logo.astro'
import Navigation from '@/components/Navigation/Navigation.astro'
import OverlayMenu from '@/components/OverlayMenu/OverlayMenu.astro'
import Button from '@/components/Button/Button.astro'

const BASE_URL = import.meta.env.BASE_URL
---

<header class="header container">
  <div class="header__inner">
    <Logo />
    <Navigation className="hidden-tablet" />
    <OverlayMenu
      className="visible-tablet"
      extraAttrs={ { 'data-navigation': "", 'id': 'main-navigation' } }
    />
    <div class="header__actions hidden-tablet">
      <Button
        className="header__action"
        variant="transparent"
        href={ `${ BASE_URL }sign-up` }
      >
        Sign Up
      </Button>
      <Button
        className="header__action"
        href={ `${ BASE_URL }login` }
      >
        Login
      </Button>
    </div>
  </div>
</header>
