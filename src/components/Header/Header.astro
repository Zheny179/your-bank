---
import './Header.scss'
import Logo from '../Logo/Logo.astro'
import Navigation from '../Navigation/Navigation.astro'
import Button from '../Button/Button.astro'
import OverlayMenu from '../OverlayMenu/OverlayMenu.astro'
---

<header class="header container">
  <div class="header__inner">
    <Logo />
    <Navigation className="hidden-tablet" />
    <OverlayMenu
      className="visible-tablet"
      extraAttrs={ { 'data-navigation': "", 'id': 'main-navigation' } }
    />
    <div class="header__actions hidden-tablet">
      <Button
        className="header__action"
        variant="transparent"
        href="sign-up"
      >
        Sign Up
      </Button>
      <Button
        className="header__action"
        href="login"
      >
        Login
      </Button>
    </div>
  </div>
</header>

<script>
  const overlayMenuElement = document.querySelector<HTMLElement>(
    '[data-overlay-menu]')

  overlayMenuElement?.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab') {
      return
    }


    const focusableElement = overlayMenuElement?.querySelectorAll<HTMLElement>(
      'a[href], button:not([disabled])'
    )

    if (focusableElement.length === 0) {
      return
    }

    const firstElement = focusableElement[0]
    const lastElement = focusableElement[focusableElement.length - 1]

    if (e.shiftKey) {
      if (document.activeElement === firstElement) {
        lastElement.focus()
        e.preventDefault()
      }
    } else {
      if (document.activeElement === lastElement) {
        firstElement.focus()
        e.preventDefault()
      }
    }
  })
</script>
